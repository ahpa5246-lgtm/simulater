{
  "name": "mina-circuit-workbench",
  "version": "0.5.0",
  "private": true,
  "description": "Local schematic workbench with native ngspice simulation",
  "scripts": {
    "start": "python server.py",
    "test": "python -m unittest discover -s tests -v",
    "test:browser": "node tests/browser.cjs",
    "test:boards": "node --test tests/test_pico.cjs",
    "test:boards-browser": "node tests/boards-browser.cjs",
    "test:instruments": "node --test tests/test_instruments.cjs",
    "test:instruments-browser": "node tests/instruments-browser.cjs",
    "test:parts-browser": "node tests/parts-browser.cjs",
    "build:peripherals": "python scripts/build-picsimlab.py",
    "vendor:wokwi": "python scripts/vendor-wokwi.py",
    "test:upstream-browser": "node tests/upstream-browser.cjs",
    "test:peripherals": "node --test tests/test_ds1621.cjs",
    "vendor:components": "python scripts/vendor-components.py",
    "test:components-browser": "node tests/component-library-browser.cjs"
  },
  "devDependencies": {
    "node-api-headers": "1.9.0",
    "playwright": "1.51.1"
  },
  "dependencies": {
    "@wokwi/elements": "1.9.2",
    "avr8js": "0.21.0",
    "rp2040js": "1.3.3"
  }
}
